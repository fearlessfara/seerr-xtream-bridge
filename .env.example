HOST=0.0.0.0
PORT=5056
LOG_LEVEL=info
TZ=Europe/Rome

DATABASE_PATH=/data/bridge.db
BRIDGE_API_KEY=change-me

SEERR_URL=http://seerr:5055
SEERR_API_KEY=
SEERR_WEBHOOK_SECRET=change-me-webhook
SEERR_AVAILABILITY_GRACE_SECONDS=60
SEERR_REQUEST_COMPLETION_GRACE_SECONDS=60

XTREAMFILTER_URL=http://gluetun:5000
XTREAMFILTER_SOURCE_ID=
XTREAMFILTER_SOURCE_NAME=Strong 8K

JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# Optional overrides if Seerr settings API is not used for *arr credentials
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=

RECONCILE_INTERVAL_SECONDS=30
XTREAM_PARTIAL_POLICY=all_or_nothing
QUALITY_UNKNOWN_POLICY=allow
QUALITY_PROFILE_CACHE_TTL_SECONDS=300

HTTP_TIMEOUT_MS=15000
BODY_LIMIT_BYTES=1048576
METRICS_REQUIRE_AUTH=false
